# PostgreSQL connection string
DATABASE_URL=postgres://civic:civic@localhost:5432/civic

# Secret used to sign session tokens. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Absolute or relative path where uploaded document files are stored
# (local storage driver; replace with object storage in production)
STORAGE_DIR=./storage

# Public origin of the deployment, used for canonical URLs / sitemap
NEXT_PUBLIC_APP_URL=http://localhost:3000
